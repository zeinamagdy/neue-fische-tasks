{
  "name": " Event Hub.",
  "version": "1.0.0",
  "description": " Event Hub using nunjucks and expressjs",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/server.js",
    "dev": "nodemon -e ts,html,njk --exec tsx src/server.ts",
    "prod": "npm run build && npm start"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/nunjucks": "^3.2.6",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prettier-plugin-jinja-template": "^2.2.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
